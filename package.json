{
  "name": "project-mirage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "cargo run --release",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "dev": "concurrently -n \"API,WEB\" -c \"magenta,cyan\" \"npm run server --silent\" \"npm run client --silent\"",
    "client": "vite",
    "server": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "app:dev": "concurrently \"NODE_ENV=development npm run client\" \"wait-on http://localhost:5173 && NODE_ENV=development electron .\"",
    "app:package": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder build --mac",
    "test": "node test-security.mjs",
    "test:security": "node test-security.mjs",
    "test:kat": "node -e \"import('./lib/kat.js').then(m=>{const r=m.summarizeKats();console.log(JSON.stringify(r,null,2));process.exit(r.overall?0:1)})\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^8.2.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.mdvsecurity.project-mirage",
    "productName": "Project Mirage",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": null,
      "icon": "resources/app_icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/app_icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "wraith",
        "name": "Project Mirage Encrypted Archive",
        "role": "Editor",
        "icon": "resources/nobug"
      }
    ],
    "files": [
      "dist/**/*",
      "preload.cjs",
      "ipc-handlers.js",
      "lib/**/*",
      "main.js",
      "package.json",
      "resources/**/*"
    ],
    "directories": {
      "output": "release"
    }
  }
}
