{
  "name": "project-mirage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "app:dev": "concurrently \"NODE_ENV=development npm run client\" \"wait-on http://localhost:5173 && NODE_ENV=development electron .\"",
    "app:package": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder build --mac"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.3.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.mdvsecurity.project-mirage",
    "productName": "Project Mirage",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": null
    },
    "files": [
      "dist/**/*",
      "certs/**/*",
      "src/token.json",
      "main.js",
      "server.js",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
