{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Mirage",
  "version": "2.2.0",
  "identifier": "com.mirage.vault",
  "build": {
    "beforeDevCommand": "npm run client",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Project Mirage // Armored Cryptosystem",
        "width": 1024,
        "height": 840,
        "minWidth": 800,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
